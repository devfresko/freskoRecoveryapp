{
  "regions": ["bom1"],
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)\\.(png|ico|svg|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
